AUTH_SECRET=change-me-to-a-long-random-string
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=*
RPC_URL=https://rpc.bohr.life
CHAIN_ID=968
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
START_BLOCK=0
CONFIRMATIONS=3
ARBITER_ADDRESS=0xYourArbiterWalletLowercaseOrNot
# Object storage for dispute evidence (any S3-compatible bucket). Leave S3_BUCKET empty only for local development.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Platform verification levels. Generate a key once:  python -c "from eth_account import Account; a=Account.create(); print(a.address, a.key.hex())"
# Keep VERIFIER_PRIVATE_KEY secret, it only signs attestations and holds no funds. ADMIN_ADDRESSES is a comma-separated list of wallets allowed to grant levels at /admin.
VERIFIER_PRIVATE_KEY=
ADMIN_ADDRESSES=
